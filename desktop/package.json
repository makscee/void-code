{
  "name": "void-code-desktop",
  "version": "0.1.3-beta.5",
  "private": true,
  "description": "Guided Void Code desktop pilot",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && npm run bundle:preload && npm run bundle:renderer",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "assemble": "node scripts/assemble-resources.mjs",
    "verify-resources": "node scripts/verify-resources.mjs resources/staged/manifest.json resources/staged",
    "package:mac": "npm run build && npm run assemble && electron-builder --dir --mac --arm64",
    "package:win": "npm run build && node scripts/assemble-windows-resources.mjs && node scripts/package-windows.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs && node scripts/packaged-window-check.mjs && node scripts/packaged-startup-failure-check.mjs",
    "check": "npm run clean && npm run lint && npm run test && npm run package:mac && npm run smoke:packaged",
    "check:mac-pty": "npm run clean && npm run lint && npm run test && npm run package:mac && node scripts/mac-pty-check.mjs",
    "check:mac-tabs": "npm run clean && npm run lint && npm run test && npm run package:mac",
    "check:status": "npm run lint && vitest run tests/status-channel.test.ts tests/session-manager.test.ts tests/workspace-close-ipc.test.ts tests/contract.test.ts",
    "bundle:preload": "esbuild src/preload/index.ts --bundle --format=cjs --platform=node --target=node22 --external:electron --outfile=dist/preload/index.js",
    "bundle:renderer": "esbuild src/renderer/index.ts --bundle --format=esm --platform=browser --target=chrome130 --loader:.woff2=file --loader:.woff=file --asset-names=assets/[name]-[hash] --outfile=dist/renderer/index.js",
    "smoke:sandbox-preload": "node scripts/sandbox-preload-smoke.cjs",
    "check:production-terminal": "npm run clean && npm run lint && npm run test && npm run package:mac && node scripts/production-terminal-check.mjs",
    "check:win-package": "npm run clean && npm run lint && npm run test && npm run package:win && node scripts/windows-package-check.mjs && node scripts/packaged-window-check.mjs && node scripts/packaged-startup-failure-check.mjs",
    "candidate:generate": "node scripts/candidate-manifest.mjs generate",
    "candidate:check": "node scripts/candidate-manifest.mjs check",
    "check:pinned-pi-smoke": "node scripts/check-pinned-pi-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.2.8",
    "@vscode/l10n": "0.0.18",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "js-yaml": "4.1.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "electron": "41.10.3",
    "electron-builder": "26.15.7",
    "esbuild": "0.25.8",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.10"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "works.voidcode.desktop",
    "afterPack": "scripts/after-pack.cjs",
    "productName": "Void Code",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/node-pty/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/@vscode/l10n/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/staged",
        "to": "private-runtime"
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Void-Code-${version}-windows-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://vc.makscee.ru/download/windows/"
      }
    ]
  }
}
